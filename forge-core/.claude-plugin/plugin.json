{
  "name": "forge-core",
  "version": "0.7.27",
  "description": "Forge 시스템 핵심 — 세션관리·cr-multi·rag-search·advisor + 하네스 정리(harness-legacy-scan/diet/external-sweep) + 감사(system-audit 6축·ACHCE 5축·migration-audit). 통합 공통 기반.",
  "author": {
    "name": "forge"
  },
  "skills": "./skills/",
  "agents": [
    "./agents/advisor-strategist.md"
  ],
  "commands": "./commands/",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/forge-onboard.sh\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/brain-integrity-check.sh\" --via-plugin",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/doc-routes-inject.sh\" --via-plugin",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/main-write-guard.sh\" --via-plugin",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/doc-routes-inject.sh\" --via-plugin",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/doc-routes-inject.sh\" --via-plugin",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "userConfig": {
    "OPENAI_API_KEY": {
      "title": "OpenAI / Codex API Key",
      "type": "string",
      "sensitive": true,
      "description": "OpenAI API key — codex MCP 서버에 사용 (시스템 환경변수로도 대체 가능)"
    }
  }
}
