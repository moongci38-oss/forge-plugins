{
  "name": "forge-core",
  "version": "0.7.3",
  "description": "Forge 시스템 핵심 — 세션관리·cr-multi·rag-search·advisor + 하네스 정리(harness-legacy-scan/diet/external-sweep/agent-drift) + 감사(system-audit 6축·ACHCE 5축·migration-audit). 통합 공통 기반.",
  "author": {
    "name": "forge"
  },
  "skills": "./skills/",
  "agents": [
    "./agents/advisor-strategist.md",
    "./agents/axis-agentic.md",
    "./agents/axis-context.md",
    "./agents/axis-cost.md",
    "./agents/axis-harness.md",
    "./agents/axis-human-ai.md"
  ],
  "commands": "./commands/",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/forge-onboard.sh\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/forge-plugin-learn-inject.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/brain-integrity-check.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-placement-advisory.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/brain-placement-guard.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/main-write-guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/forge-plugin-learn-reminder.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "userConfig": {
    "GEMINI_API_KEY": {
      "title": "Gemini API Key",
      "type": "string",
      "sensitive": true,
      "description": "Google Gemini API key — gemini MCP + nano-banana image generation에 사용"
    },
    "OPENAI_API_KEY": {
      "title": "OpenAI / Codex API Key",
      "type": "string",
      "sensitive": true,
      "description": "OpenAI API key — codex MCP 서버에 사용 (시스템 환경변수로도 대체 가능)"
    }
  }
}
